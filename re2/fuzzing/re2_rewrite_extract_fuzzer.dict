# Dictionary for re2_rewrite_extract_fuzzer: multi-byte tokens traceable to
# RE2 source constructs (re2.cc Rewrite/MaxSubmatch escape tokens, parse.cc
# group constructs). Deliberately no single-character tokens.
sub0="\\0"
sub1="\\1"
sub2="\\2"
sub3="\\3"
sub4="\\4"
sub5="\\5"
sub6="\\6"
sub7="\\7"
sub8="\\8"
sub9="\\9"
escbs="\\\\"
grp="(a)"
grp_ng="(?:x)"
named="(?P<n>"
named_end="(?P<n>x)"
bound="\\b"
nbound="\\B"
zend="\\z"
digcls="\\d"
wordcls="\\w+"
brace="{1,3}"
cls="[a-z]"
